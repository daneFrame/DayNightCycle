using UnityEngine;

public class DayNightCycle : MonoBehaviour
{
    [Header("Time Settings")]
    [Tooltip("Length of a full day in real-world seconds")]
    public float dayLengthInSeconds = 120f;
    [Range(0f, 1f)]
    public float currentTimeOfDay = 0.25f; // 0 = Midnight, 0.25 = Dawn, 0.5 = Noon, 0.75 = Dusk

    [Header("Lighting References")]
    public Light sunLight;
    public Gradient sunColor;
    public AnimationCurve sunIntensity;

    [Header("Rotation Settings")]
    public Vector3 rotationAxis = new Vector3(1, 0, 0); // Rotates along the X axis

    private float initialIntensity;

    void Start()
    {
        if (sunLight != null)
        {
            initialIntensity = sunLight.intensity;
        }
    }

    void Update()
    {
        UpdateTimer();
        UpdateSunRotation();
        UpdateSunAttributes();
    }

    private void UpdateTimer()
    {
        // Progress time linearly based on frame rates
        currentTimeOfDay += Time.deltaTime / dayLengthInSeconds;

        // Loop the day cycle back to 0 once it hits 1
        if (currentTimeOfDay >= 1f)
        {
            currentTimeOfDay = 0f;
        }
    }

    private void UpdateSunRotation()
    {
        if (sunLight == null) return;

        // Calculate rotation: 360 degrees multiplied by time progression
        // Offsetting by -90 degrees so 0.25 lines up with dawn/horizon
        float angle = (currentTimeOfDay * 360f) - 90f;

        sunLight.transform.localRotation = Quaternion.AngleAxis(angle, rotationAxis);
    }

    private void UpdateSunAttributes()
    {
        if (sunLight == null) return;

        // Apply gradient colors (e.g., orange for sunset, bright yellow for noon)
        if (sunColor != null)
        {
            sunLight.color = sunColor.Evaluate(currentTimeOfDay);
        }

        // Apply intensity curves (e.g., 0 at night, 1 at noon)
        if (sunIntensity != null)
        {
            sunLight.intensity = initialIntensity * sunIntensity.Evaluate(currentTimeOfDay);
        }
    }
}
